<canvas id="hero-sky" aria-hidden="true"></canvas>

<style>
  #hero-sky {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    z-index: 1;
  }
</style>

<script>
  // "Ghazali's sky", scenic cut: a night diorama between the two worlds.
  // Sky: indigo deepening to a warm horizon, the sphere of fixed stars
  // twinkling, an octagram traced between the studied stars. Water: the sky
  // mirrored as rippling reflections, a crescent moon with a glitter path,
  // mist drifting along the shore. Ridges with a small mosque silhouette
  // hold the horizon. Shooting stars visit occasionally, and divinate
  // nothing. three.js is dynamically imported after idle, homepage-only;
  // skipped under prefers-reduced-motion; paused offscreen or hidden.
  const boot = async () => {
    const canvas = document.getElementById('hero-sky') as HTMLCanvasElement | null;
    if (!canvas || !canvas.parentElement) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const THREE = await import('three');
    let renderer: import('three').WebGLRenderer;
    try {
      renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: false, powerPreference: 'low-power' });
    } catch {
      return;
    }
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.5));

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(60, 1, 0.1, 200);
    camera.position.set(0, 0, 8);

    const HORIZON = -1.15;   // world y of the water line
    const MOON_X = 8.5;

    const dpr2ctx = (w: number, h: number) => {
      const c = document.createElement('canvas');
      c.width = w; c.height = h;
      return [c, c.getContext('2d')!] as const;
    };

    // ── textures drawn on offscreen canvases ────────────────────
    function moonTexture() {
      const [c, g] = dpr2ctx(256, 256);
      const glow = g.createRadialGradient(128, 128, 8, 128, 128, 124);
      glow.addColorStop(0, 'rgba(242, 226, 188, 0.5)');
      glow.addColorStop(0.45, 'rgba(223, 190, 130, 0.16)');
      glow.addColorStop(1, 'rgba(223, 190, 130, 0)');
      g.fillStyle = glow;
      g.fillRect(0, 0, 256, 256);
      g.fillStyle = '#f2e6c4';
      g.beginPath();
      g.arc(122, 128, 46, 0, Math.PI * 2);
      g.fill();
      g.globalCompositeOperation = 'destination-out';
      g.beginPath();
      g.arc(146, 116, 44, 0, Math.PI * 2);
      g.fill();
      const t = new THREE.CanvasTexture(c);
      t.colorSpace = THREE.SRGBColorSpace;
      return t;
    }

    function mistTexture() {
      const [c, g] = dpr2ctx(256, 128);
      const rg = g.createRadialGradient(128, 64, 4, 128, 64, 120);
      rg.addColorStop(0, 'rgba(210, 224, 240, 0.65)');
      rg.addColorStop(1, 'rgba(210, 224, 240, 0)');
      g.save();
      g.scale(1, 0.5);
      g.translate(0, 64);
      g.fillStyle = rg;
      g.fillRect(0, -64, 256, 256);
      g.restore();
      const t = new THREE.CanvasTexture(c);
      t.colorSpace = THREE.SRGBColorSpace;
      return t;
    }

    function ridgeTexture(near: boolean) {
      const W = 2048, H = 512;
      const [c, g] = dpr2ctx(W, H);
      const baseY = H * 0.72; // water line inside the drawing
      const top: number[] = [];
      for (let x = 0; x <= W; x += 8) {
        const u = x / W * Math.PI * 2;
        const h = near
          ? 34 * Math.sin(u * 1.7 + 1.2) + 22 * Math.sin(u * 3.3 + 4.0) + 14 * Math.sin(u * 0.6 + 0.6)
          : 24 * Math.sin(u * 2.1 + 2.8) + 16 * Math.sin(u * 4.7 + 0.4) + 10 * Math.sin(u * 0.9 + 2.2);
        top.push(baseY - 46 + h);
      }
      g.fillStyle = near ? '#0b0f18' : '#131827';
      g.beginPath();
      g.moveTo(0, H);
      top.forEach((y, i) => g.lineTo(i * 8, y));
      g.lineTo(W, H);
      g.closePath();
      g.fill();

      if (near) {
        // a small mosque on the ridge, at 30% across
        const mx = W * 0.30;
        const my = top[Math.floor(mx / 8)];
        const s = 1.0;
        g.fillStyle = '#0b0f18';
        g.fillRect(mx - 130 * s, my - 16 * s, 260 * s, 16 * s);
        g.beginPath();
        g.arc(mx, my - 16 * s, 62 * s, Math.PI, 0);
        g.fill();
        g.fillRect(mx - 62 * s, my - 22 * s, 124 * s, 8 * s);
        g.beginPath();
        g.arc(mx, my - 92 * s, 4 * s, 0, Math.PI * 2);
        g.fill();
        g.fillRect(mx - 1.5 * s, my - 88 * s, 3 * s, 12 * s);
        for (const dx of [-172, 172]) {
          g.fillRect(mx + dx * s - 7 * s, my - 96 * s, 14 * s, 96 * s);
          g.beginPath();
          g.arc(mx + dx * s, my - 100 * s, 9 * s, Math.PI, 0);
          g.fill();
          g.beginPath();
          g.arc(mx + dx * s, my - 112 * s, 3 * s, 0, Math.PI * 2);
          g.fill();
        }
        // lit windows, warm
        g.fillStyle = 'rgba(223, 167, 95, 0.85)';
        for (const dx of [-34, 0, 34]) {
          g.beginPath();
          g.arc(mx + dx * s, my - 34 * s, 3.4 * s, 0, Math.PI * 2);
          g.fill();
        }
        g.fillRect(mx - 5 * s, my - 60 * s, 10 * s, 12 * s);
      }
      const t = new THREE.CanvasTexture(c);
      t.colorSpace = THREE.SRGBColorSpace;
      return { tex: t, aspect: W / H };
    }

    // ── point shader: sky (twinkle) / mirror (ripple) / glitter ──
    const vert = /* glsl */ `
      uniform float uTime;
      uniform float uHorizon;
      uniform float uMirror;
      uniform float uReveal;
      attribute float aSize;
      attribute vec3 aColor;
      attribute float aPhase;
      varying vec3 vColor;
      varying float vAlpha;
      void main() {
        vec3 p = position;
        float tw = 0.72 + 0.28 * sin(uTime * (0.5 + aPhase * 0.9) + aPhase * 21.0);
        float reveal = clamp(uReveal * 1.5 - aPhase * 0.5, 0.0, 1.0);
        reveal = reveal * reveal * (3.0 - 2.0 * reveal);
        if (uMirror > 1.5) {
          // moon glitter: a wobbling column of warm sparks on the water
          p.x += sin(uTime * 1.1 + position.z * 2.0 + aPhase * 40.0) * 0.09;
          p.y += sin(uTime * 0.7 + position.x * 1.3) * 0.02;
          vAlpha = reveal * tw * 0.55;
          vColor = vec3(0.95, 0.8, 0.52);
        } else if (uMirror > 0.5) {
          p.y = 2.0 * uHorizon - p.y;
          float d = max(uHorizon - p.y, 0.0);
          p.x += sin(uTime * 0.9 + position.x * 2.3 + position.y * 1.4) * 0.055
               + sin(uTime * 0.37 + position.y * 0.8) * 0.032;
          p.y += sin(uTime * 0.55 + position.x * 1.1) * 0.03;
          vAlpha = reveal * 0.8 * clamp(1.0 - d / 6.0, 0.15, 1.0);
          vColor = aColor * vec3(0.8, 0.88, 1.0) * 0.95;
        } else {
          vAlpha = reveal * mix(0.35, 1.0, tw);
          vColor = aColor;
        }
        vec4 mv = modelViewMatrix * vec4(p, 1.0);
        gl_PointSize = aSize * (46.0 / -mv.z);
        gl_Position = projectionMatrix * mv;
      }
    `;
    const frag = /* glsl */ `
      varying vec3 vColor;
      varying float vAlpha;
      void main() {
        float d = length(gl_PointCoord - 0.5);
        float a = smoothstep(0.5, 0.06, d) * vAlpha;
        if (a < 0.012) discard;
        gl_FragColor = vec4(vColor, a);
      }
    `;
    const uniforms = () => ({
      uTime: { value: 0 },
      uHorizon: { value: HORIZON },
      uMirror: { value: 0 },
      uReveal: { value: 0 },
    });

    // ── fixed stars (behind the ridges, at infinity-ish) ─────────
    const N = 950;
    const pos = new Float32Array(N * 3);
    const col = new Float32Array(N * 3);
    const size = new Float32Array(N);
    const phase = new Float32Array(N);
    const cream = [0.94, 0.91, 0.86];
    const amber = [0.87, 0.65, 0.37];
    for (let i = 0; i < N; i++) {
      pos[i * 3] = (Math.random() - 0.5) * 60;
      pos[i * 3 + 1] = HORIZON + 0.2 + Math.random() * 9;
      pos[i * 3 + 2] = -38 - Math.random() * 28;
      const base = Math.random() < 0.18 ? amber : cream;
      const dim = 0.28 + Math.random() * 0.6;
      col[i * 3] = base[0] * dim;
      col[i * 3 + 1] = base[1] * dim;
      col[i * 3 + 2] = base[2] * dim;
      size[i] = 1.2 + Math.random() * 2.0;
      phase[i] = Math.random();
    }
    const starGeo = new THREE.BufferGeometry();
    starGeo.setAttribute('position', new THREE.BufferAttribute(pos, 3));
    starGeo.setAttribute('aColor', new THREE.BufferAttribute(col, 3));
    starGeo.setAttribute('aSize', new THREE.BufferAttribute(size, 1));
    starGeo.setAttribute('aPhase', new THREE.BufferAttribute(phase, 1));

    // ── the traced figure: octagram between the studied stars ────
    const C = { x: 2.5, y: 1.35, z: -5.5, s: 1.55 };
    const sq = (rot: number): [number, number][] =>
      [0, 1, 2, 3].map((i) => {
        const a = rot + (i * Math.PI) / 2 + Math.PI / 4;
        return [C.x + C.s * Math.cos(a), C.y + C.s * Math.sin(a)];
      });
    const A = sq(0), B = sq(Math.PI / 4);
    const linePts: number[] = [];
    for (const S of [A, B]) {
      for (let i = 0; i < 4; i++) {
        const [x1, y1] = S[i];
        const [x2, y2] = S[(i + 1) % 4];
        linePts.push(x1, y1, C.z, x2, y2, C.z);
      }
    }
    const lineGeo = new THREE.BufferGeometry();
    lineGeo.setAttribute('position', new THREE.BufferAttribute(new Float32Array(linePts), 3));
    const lines = new THREE.LineSegments(
      lineGeo,
      new THREE.LineBasicMaterial({ color: 0xdfa75f, transparent: true, opacity: 0.3 })
    );
    lines.geometry.setDrawRange(0, 0);

    const VN = 8;
    const vPos = new Float32Array(VN * 3);
    const vCol = new Float32Array(VN * 3);
    const vSize = new Float32Array(VN);
    const vPhase = new Float32Array(VN);
    [...A, ...B].forEach(([x, y], i) => {
      vPos[i * 3] = x; vPos[i * 3 + 1] = y; vPos[i * 3 + 2] = C.z;
      vCol[i * 3] = 0.95; vCol[i * 3 + 1] = 0.74; vCol[i * 3 + 2] = 0.45;
      vSize[i] = 1.5 + (i % 2) * 0.5;
      vPhase[i] = 0.25 + i * 0.07;
    });
    const vertGeo = new THREE.BufferGeometry();
    vertGeo.setAttribute('position', new THREE.BufferAttribute(vPos, 3));
    vertGeo.setAttribute('aColor', new THREE.BufferAttribute(vCol, 3));
    vertGeo.setAttribute('aSize', new THREE.BufferAttribute(vSize, 1));
    vertGeo.setAttribute('aPhase', new THREE.BufferAttribute(vPhase, 1));

    const skyMat = new THREE.ShaderMaterial({
      uniforms: uniforms(),
      vertexShader: vert, fragmentShader: frag,
      transparent: true, depthWrite: false,
    });
    const reflMat = new THREE.ShaderMaterial({
      uniforms: Object.assign(uniforms(), { uMirror: { value: 1 } }),
      vertexShader: vert, fragmentShader: frag,
      transparent: true, depthWrite: false, depthTest: false,
    });

    const celestial = new THREE.Group();
    const skyStars = new THREE.Points(starGeo, skyMat);
    const skyVerts = new THREE.Points(vertGeo, skyMat);
    skyStars.renderOrder = 2; skyVerts.renderOrder = 3; lines.renderOrder = 3;
    celestial.add(skyStars, skyVerts, lines);
    scene.add(celestial);

    // reflections share geometry; mirrored + rippled in-shader
    const reflStars = new THREE.Points(starGeo, reflMat);
    const reflVerts = new THREE.Points(vertGeo, reflMat);
    reflStars.renderOrder = 5; reflVerts.renderOrder = 5;
    scene.add(reflStars, reflVerts);

    // ── water surface: depth-graded, rippling, moon glitter path ──
    const waterMat = new THREE.ShaderMaterial({
      uniforms: { uTime: { value: 0 }, uMoonX: { value: MOON_X } },
      vertexShader: /* glsl */ `
        varying vec3 vW;
        void main() {
          vW = (modelMatrix * vec4(position, 1.0)).xyz;
          gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
        }
      `,
      fragmentShader: /* glsl */ `
        uniform float uTime;
        uniform float uMoonX;
        varying vec3 vW;
        void main() {
          float depth = -vW.z;
          float f = clamp((depth - 8.0) / 50.0, 0.0, 1.0);
          vec3 col = mix(vec3(0.012, 0.020, 0.034), vec3(0.045, 0.058, 0.085), f);
          col = mix(col, vec3(0.10, 0.082, 0.058), smoothstep(0.72, 1.0, f) * 0.85);
          float rip = 0.5 + 0.5 * sin(vW.x * 1.3 + uTime * 0.8 + sin(vW.x * 0.4 - uTime * 0.45 + vW.z * 0.2) * 1.2);
          col += rip * 0.02;
          float gw = exp(-pow((vW.x - uMoonX) / (0.5 + depth * 0.16), 2.0));
          float gl = gw * clamp(depth * 0.12, 0.0, 1.0)
                   * (0.5 + 0.5 * sin(uTime * 1.8 + vW.x * 2.7 + sin(vW.z + uTime) * 2.0));
          col += gl * vec3(0.30, 0.23, 0.12);
          gl_FragColor = vec4(col, 1.0);
        }
      `,
    });
    const water = new THREE.Mesh(new THREE.PlaneGeometry(400, 70), waterMat);
    water.rotation.x = -Math.PI / 2;
    water.position.set(0, HORIZON, -42);
    scene.add(water);

    // ── ridges with the mosque silhouette ────────────────────────
    const mkRidge = (near: boolean, z: number, worldW: number) => {
      const { tex, aspect } = ridgeTexture(near);
      const worldH = worldW / aspect;
      const m = new THREE.Mesh(
        new THREE.PlaneGeometry(worldW, worldH),
        new THREE.MeshBasicMaterial({ map: tex, transparent: true, alphaTest: 0.5 })
      );
      m.position.set(0, HORIZON + worldH / 2 - worldH * 0.28, z);
      m.renderOrder = 1;
      scene.add(m);
    };
    mkRidge(false, -34, 150);
    mkRidge(true, -21, 110);

    // ── moon + glitter path ──────────────────────────────────────
    const moonMat = new THREE.SpriteMaterial({ map: moonTexture(), transparent: true, opacity: 0, depthWrite: false });
    const moon = new THREE.Sprite(moonMat);
    moon.scale.set(4.6, 4.6, 1);
    moon.position.set(MOON_X, 4.3, -30);
    moon.renderOrder = 6;
    scene.add(moon);

    const GN = 150;
    const gPos = new Float32Array(GN * 3);
    const gCol = new Float32Array(GN * 3);
    const gSize = new Float32Array(GN);
    const gPhase = new Float32Array(GN);
    for (let i = 0; i < GN; i++) {
      const z = -4 - Math.random() * 22;
      const d = -z - 4;
      gPos[i * 3] = MOON_X + (Math.random() - 0.5) * (0.5 + d * 0.28);
      gPos[i * 3 + 1] = HORIZON - 0.15 - Math.random() * (1.5 + d * 0.18);
      gPos[i * 3 + 2] = z;
      gSize[i] = 0.4 + Math.random() * 0.9;
      gPhase[i] = Math.random();
    }
    const glitGeo = new THREE.BufferGeometry();
    glitGeo.setAttribute('position', new THREE.BufferAttribute(gPos, 3));
    glitGeo.setAttribute('aColor', new THREE.BufferAttribute(gCol, 3));
    glitGeo.setAttribute('aSize', new THREE.BufferAttribute(gSize, 1));
    glitGeo.setAttribute('aPhase', new THREE.BufferAttribute(gPhase, 1));
    const glitMat = new THREE.ShaderMaterial({
      uniforms: Object.assign(uniforms(), { uMirror: { value: 2 } }),
      vertexShader: vert, fragmentShader: frag,
      transparent: true, depthWrite: false, depthTest: false,
    });
    const glitter = new THREE.Points(glitGeo, glitMat);
    glitter.renderOrder = 6;
    scene.add(glitter);

    // ── mist along the shore ─────────────────────────────────────
    const mistTex = mistTexture();
    const mists: { s: THREE.Sprite; x0: number; sp: number }[] = [];
    for (const [x0, y, w, o] of [[-14, 0.35, 30, 0.05], [4, 0.15, 40, 0.07], [16, 0.5, 26, 0.045]] as const) {
      const m = new THREE.Sprite(new THREE.SpriteMaterial({
        map: mistTex, transparent: true, opacity: o, depthWrite: false, depthTest: false, color: 0x9db0c4,
      }));
      m.scale.set(w, w / 8, 1);
      m.position.set(x0, HORIZON + y, -14);
      m.renderOrder = 7;
      mists.push({ s: m, x0, sp: 0.12 + Math.random() * 0.08 });
      scene.add(m);
    }

    // ── shooting star ────────────────────────────────────────────
    const ssMat = new THREE.LineBasicMaterial({
      color: 0xfff2d8, transparent: true, opacity: 0, blending: THREE.AdditiveBlending,
    });
    const ssGeo = new THREE.BufferGeometry().setFromPoints([new THREE.Vector3(), new THREE.Vector3()]);
    const shooting = new THREE.Line(ssGeo, ssMat);
    shooting.renderOrder = 8;
    scene.add(shooting);
    let ssNext = 7, ssT0 = -1, ssDur = 0.9;
    const ssFrom = new THREE.Vector3(), ssDir = new THREE.Vector3();

    // ── interaction, lifecycle, loop ─────────────────────────────
    let mx = 0, my = 0;
    window.addEventListener('pointermove', (e) => {
      mx = (e.clientX / window.innerWidth) * 2 - 1;
      my = (e.clientY / window.innerHeight) * 2 - 1;
    }, { passive: true });

    const resize = () => {
      const w = canvas.parentElement!.clientWidth;
      const h = canvas.parentElement!.clientHeight;
      renderer.setSize(w, h, false);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
    };
    resize();
    window.addEventListener('resize', resize);

    let heroVisible = true;
    new IntersectionObserver(([entry]) => {
      heroVisible = entry.isIntersecting;
    }).observe(canvas);
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) tick(performance.now());
    });

    let last = performance.now();
    const t0 = last;
    function tick(now: number) {
      const dt = Math.min((now - last) / 1000, 0.05);
      last = now;
      const t = (now - t0) / 1000;

      celestial.rotation.y = Math.sin(t * 0.02) * 0.05 + t * 0.004;
      skyMat.uniforms.uTime.value = t;
      skyMat.uniforms.uReveal.value = Math.min(t / 6, 1);
      reflMat.uniforms.uTime.value = t;
      reflMat.uniforms.uReveal.value = Math.min(Math.max((t - 1.2) / 6, 0), 1);
      glitMat.uniforms.uTime.value = t;
      glitMat.uniforms.uReveal.value = Math.min(Math.max((t - 2.5) / 6, 0), 1);
      waterMat.uniforms.uTime.value = t;
      moonMat.opacity = Math.min(Math.max((t - 0.6) / 2.5, 0), 1);

      const seg = Math.min(8, Math.floor(t / 0.9));
      lines.geometry.setDrawRange(0, seg * 2);

      for (const m of mists) {
        m.s.position.x = m.x0 + Math.sin(t * m.sp) * 7;
      }

      // shooting star state machine
      if (ssT0 < 0 && t > ssNext) {
        ssT0 = t;
        ssDur = 0.7 + Math.random() * 0.4;
        ssFrom.set(-10 + Math.random() * 20, 4.5 + Math.random() * 3.5, -24);
        const left = Math.random() < 0.5;
        ssDir.set(left ? -1 : 1, -(0.45 + Math.random() * 0.25), 0).normalize();
      }
      if (ssT0 >= 0) {
        const p = (t - ssT0) / ssDur;
        if (p >= 1) {
          ssT0 = -1; ssNext = t + 8 + Math.random() * 12;
          ssMat.opacity = 0;
        } else {
          const head = ssFrom.clone().addScaledVector(ssDir, p * 14);
          const tail = head.clone().addScaledVector(ssDir, -1.6);
          ssGeo.setFromPoints([head, tail]);
          ssMat.opacity = Math.sin(Math.PI * p) * 0.85;
        }
      }

      camera.position.x += (mx * 0.3 - camera.position.x) * 0.04;
      camera.position.y += (-my * 0.2 - camera.position.y) * 0.04;
      camera.lookAt(0, 0.5, -5);
      renderer.render(scene, camera);
      if (heroVisible && !document.hidden) requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  };

  const idle = (window as any).requestIdleCallback ?? ((cb: () => void) => setTimeout(cb, 300));
  idle(() => { void boot(); });
</script>
