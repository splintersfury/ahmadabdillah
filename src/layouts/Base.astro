---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/inter';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Ahmad Abdillah',
  description = 'Between Sujood and Syscalls: essays on deen, craft, and the machine by Ahmad Abdillah.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="RSS" href="/rss.xml" />
  </head>
  <body>
    <header>
      <a class="site-name" href="/">Ahmad Abdillah</a>
      <nav>
        <a href="/essays/">Essays</a>
        <a href="/notes/">Notes</a>
        <a href="/reading/">Reading</a>
        <a href="/about/">About</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>&copy; {new Date().getFullYear()} Ahmad Abdillah &middot; <a href="/rss.xml">RSS</a></p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #101014;
    --text: #d6d6dd;
    --muted: #8a8a96;
    --accent: #c9a86a;
    --border: #26262e;
    --max: 42rem;
  }
  * { box-sizing: border-box; }
  html { color-scheme: dark; }
  body {
    margin: 0 auto;
    padding: 2.5rem 1.25rem 4rem;
    max-width: var(--max);
    background: var(--bg);
    color: var(--text);
    font-family: 'Inter Variable', system-ui, sans-serif;
    font-size: 1.0625rem;
    line-height: 1.75;
  }
  h1, h2, h3 {
    font-family: 'Fraunces Variable', Georgia, serif;
    font-weight: 560;
    line-height: 1.25;
    color: #f0ede6;
  }
  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; }
  header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 3rem;
  }
  .site-name {
    font-family: 'Fraunces Variable', Georgia, serif;
    font-size: 1.2rem;
    color: #f0ede6;
  }
  nav a { color: var(--muted); margin-left: 1.1rem; font-size: 0.95rem; }
  nav a:first-child { margin-left: 0; }
  footer {
    margin-top: 4rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.9rem;
  }
  article img { max-width: 100%; }
  pre { overflow-x: auto; }
</style>
