---
import '../styles/global.css';
import '@fontsource/instrument-serif';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/400.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Ahmad Abdillah',
  description = 'Between Sujood and Syscalls: essays on deen, craft, and the machine by Ahmad Abdillah.',
} = Astro.props;

const nav = [
  { href: '/essays/', label: 'Essays' },
  { href: '/notes/', label: 'Notes' },
  { href: '/reading/', label: 'Reading' },
  { href: '/about/', label: 'About' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="RSS" href="/rss.xml" />
  </head>
  <body>
    <header>
      <div class="wrap bar">
        <a class="wordmark" href="/">Ahmad Abdillah</a>
        <nav>
          {nav.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
      </div>
    </header>
    <slot />
    <footer>
      <div class="wrap">
        <p class="foot-name">Ahmad Abdillah</p>
        <p class="foot-line">I write about deen, craft, and the machine.</p>
        <p class="foot-links">
          <a href="/rss.xml">Subscribe via RSS</a>
          <span aria-hidden="true"> &middot; </span>
          <a href="/about/">About</a>
        </p>
        <p class="foot-copy">&copy; {new Date().getFullYear()} Ahmad Abdillah</p>
      </div>
    </footer>
  </body>
</html>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-block: 0.9rem;
  }
  .wordmark {
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--text);
  }
  .wordmark:hover { color: var(--accent); text-decoration: none; }
  nav { display: flex; gap: 1.4rem; }
  nav a {
    color: var(--text-muted);
    font-size: 0.92rem;
  }
  nav a:hover { color: var(--accent); text-decoration: none; }
  footer {
    border-top: 1px solid var(--border);
    padding-block: 3rem 3.5rem;
    background: var(--bg);
  }
  .foot-name { margin: 0; font-family: var(--font-display); font-size: 1.2rem; }
  .foot-line { margin: 0.3rem 0 0; color: var(--text-secondary); }
  .foot-links { margin: 1rem 0 0; font-size: 0.92rem; }
  .foot-copy { margin: 1.5rem 0 0; color: var(--text-muted); font-size: 0.85rem; }
</style>
