---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const essays = (await getCollection('essays', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const fmt = (d: Date) => d.toLocaleDateString('en-SG', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Base title="Essays · Ahmad Abdillah">
  <div class="wrap page">
    <p class="kicker">Essays</p>
    <h1>Long thoughts, given room.</h1>
    <ul class="list">
      {essays.map((essay) => (
        <li>
          <a class="item-title" href={`/essays/${essay.slug}/`}>{essay.data.title}</a>
          {essay.data.series && <span class="series">{essay.data.series}</span>}
          <p class="meta"><time datetime={essay.data.pubDate.toISOString()}>{fmt(essay.data.pubDate)}</time></p>
          <p class="desc">{essay.data.description}</p>
        </li>
      ))}
    </ul>
  </div>
</Base>

<style>
  .page { padding-block: clamp(2.5rem, 6vw, 4rem) 4rem; }
  h1 {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 6vw, 3.6rem);
    line-height: 1;
    letter-spacing: -0.04em;
    margin: 0 0 2.5rem;
  }
  .list { list-style: none; margin: 0; padding: 0; }
  .list li { padding-block: 1.6rem; border-top: 1px solid var(--border); }
  .item-title { color: var(--text); }
  .item-title:hover { color: var(--accent); text-decoration: none; }
  .series { margin-left: 0.6rem; color: var(--text-muted); font-style: italic; font-size: 0.9rem; }
  .desc { margin: 0.4rem 0 0; color: var(--text-secondary); max-width: 36rem; }
</style>
