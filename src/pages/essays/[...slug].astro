---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const essays = await getCollection('essays', ({ data }) => !data.draft);
  return essays.map((essay) => ({
    params: { slug: essay.slug },
    props: { essay },
  }));
}

const { essay } = Astro.props;
const { Content } = await render(essay);

const dateFmt = { year: 'numeric', month: 'long', day: 'numeric' } as const;
---

<Base title={`${essay.data.title} · Ahmad Abdillah`} description={essay.data.description}>
  <article class="wrap page">
    <p class="kicker">{essay.data.series ?? 'Essay'}</p>
    <h1>{essay.data.title}</h1>
    <p class="meta"><time datetime={essay.data.pubDate.toISOString()}>{essay.data.pubDate.toLocaleDateString('en-SG', dateFmt)}</time></p>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  .page { padding-block: clamp(2.5rem, 6vw, 4rem) 4rem; }
  h1 {
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 7vw, 4.2rem);
    line-height: 0.98;
    letter-spacing: -0.04em;
    margin: 0 0 0.9rem;
    max-width: 16ch;
  }
  .meta { margin: 0 0 2.8rem; }
</style>
