---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const essays = await getCollection('essays', ({ data }) => !data.draft);
  return essays.map((essay) => ({
    params: { slug: essay.slug },
    props: { essay },
  }));
}

const { essay } = Astro.props;
const { Content } = await render(essay);

const dateFmt = { year: 'numeric', month: 'long', day: 'numeric' } as const;
---

<Base title={`${essay.data.title} · Ahmad Abdillah`} description={essay.data.description}>
  <article>
    <header>
      <h1>{essay.data.title}</h1>
      <p class="meta">
        <time datetime={essay.data.pubDate.toISOString()}>
          {essay.data.pubDate.toLocaleDateString('en-SG', dateFmt)}
        </time>
        {essay.data.series && <span class="series"> &middot; {essay.data.series}</span>}
      </p>
    </header>
    <Content />
  </article>
</Base>

<style>
  header { margin-bottom: 2.5rem; }
  h1 { font-size: 2rem; margin-bottom: 0.5rem; }
  .meta { color: var(--muted); font-size: 0.9rem; margin: 0; }
  .series { font-style: italic; }
</style>
