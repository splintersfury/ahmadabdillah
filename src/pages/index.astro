---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const essays = (await getCollection('essays', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Base>
  <section class="intro">
    <h1>Ahmad Abdillah</h1>
    <p class="tagline">Between Sujood and Syscalls.</p>
    <p>
      Essays on deen, craft, and the machine. Written from Singapore, where the
      security work and the spiritual work keep turning out to be the same work.
    </p>
  </section>

  <section>
    <h2>Essays</h2>
    <ul class="post-list">
      {essays.map((essay) => (
        <li>
          <a href={`/essays/${essay.slug}/`}>{essay.data.title}</a>
          <span class="meta">
            <time datetime={essay.data.pubDate.toISOString()}>
              {essay.data.pubDate.toLocaleDateString('en-SG', { year: 'numeric', month: 'short', day: 'numeric' })}
            </time>
          </span>
          <p class="desc">{essay.data.description}</p>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .intro h1 { font-size: 2.2rem; margin: 0; }
  .tagline {
    color: var(--accent);
    font-family: 'Fraunces Variable', Georgia, serif;
    font-size: 1.25rem;
    margin: 0.5rem 0 0;
  }
  section + section { margin-top: 3rem; }
  h2 {
    font-size: 1.15rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .post-list { list-style: none; margin: 0; padding: 0; }
  .post-list li { margin-bottom: 1.75rem; }
  .post-list a {
    font-family: 'Fraunces Variable', Georgia, serif;
    font-size: 1.25rem;
    color: #f0ede6;
  }
  .meta { margin-left: 0.75rem; color: var(--muted); font-size: 0.85rem; }
  .desc { margin: 0.25rem 0 0; color: var(--muted); }
</style>
