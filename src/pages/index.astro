---
import Base from '../layouts/Base.astro';
import HeroSky from '../components/HeroSky.astro';
import { getCollection, render } from 'astro:content';

const essays = (await getCollection('essays', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const notes = (await getCollection('notes')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
).slice(0, 4);
const renderedNotes = await Promise.all(
  notes.map(async (note) => ({ note, Content: (await render(note)).Content }))
);
const reading = (await getCollection('reading')).sort(
  (a, b) => b.data.readDate.valueOf() - a.data.readDate.valueOf()
).slice(0, 4);

const essayBySlug = Object.fromEntries(essays.map((e) => [e.slug, e]));
const flag = (slug: string) => essayBySlug[slug];
const fmt = (d: Date) => d.toLocaleDateString('en-SG', { year: 'numeric', month: 'short', day: 'numeric' });
---

<Base>
  <section class="hero">
    <HeroSky />
    <div class="wrap hero-inner">
      <p class="eyebrow">~/between-sujood-and-syscalls</p>
      <h1>Ahmad Abdillah</h1>
      <p class="lede">
        Essays on deen, craft, and the machine. Written from Singapore, where the
        security work and the spiritual work keep turning out to be the same work.
      </p>
    </div>
  </section>

  <section class="band band-paper">
    <div class="wrap">
      <p class="kicker">Reading by interest</p>
      <div class="buckets">
        <div class="bucket">
          <p class="bucket-label">If work feels unseen</p>
          {flag('01-no-one-was-watching') ? (
            <a class="item-title" href={`/essays/01-no-one-was-watching/`}>No One Was Watching</a>
          ) : (
            <span class="item-title pending">Coming soon</span>
          )}
          <p class="bucket-desc">Ihsan, and why excellence does not need an audience.</p>
        </div>
        <div class="bucket">
          <p class="bucket-label">If AI makes you uneasy</p>
          {flag('02-eloquence-is-not-knowledge') ? (
            <a class="item-title" href={`/essays/02-eloquence-is-not-knowledge/`}>Eloquence Is Not Knowledge</a>
          ) : (
            <span class="item-title pending">Coming soon</span>
          )}
          <p class="bucket-desc">Al-Ghazali's clever debater, reborn as a language model.</p>
        </div>
        <div class="bucket">
          <p class="bucket-label">If you build for a living</p>
          <span class="item-title pending">Coming soon</span>
          <p class="bucket-desc">Craft as worship, and shipping as character.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="band band-ground">
    <div class="wrap">
      <p class="kicker">Topics I keep returning to</p>
      <ol class="topics">
        <li><span class="topic-num">01</span> Ihsan at work</li>
        <li><span class="topic-num">02</span> Sincerity against performance</li>
        <li><span class="topic-num">03</span> Al-Ghazali and knowledge</li>
        <li><span class="topic-num">04</span> AI and discernment</li>
        <li><span class="topic-num">05</span> Craft: security, engineering, building</li>
      </ol>
    </div>
  </section>

  <section class="band band-raised">
    <div class="wrap">
      <p class="kicker">Short notes</p>
      {notes.length === 0 ? (
        <p class="empty">Nothing yet. Notes are one-to-three-paragraph captures; most never become essays, and that is the point.</p>
      ) : (
        <ul class="rows">
          {renderedNotes.map(({ note, Content }) => (
            <li>
              <time class="meta" datetime={note.data.pubDate.toISOString()}>{fmt(note.data.pubDate)}</time>
              <div class="note-body"><Content /></div>
            </li>
          ))}
        </ul>
      )}
      <p class="more"><a href="/notes/">All notes</a></p>
    </div>
  </section>

  <section class="band band-ground">
    <div class="wrap">
      <p class="kicker">Reading</p>
      {reading.length === 0 ? (
        <p class="empty">Nothing logged yet. What went in, where it came from, and what stayed.</p>
      ) : (
        <ul class="rows">
          {reading.map((entry) => (
            <li>
              <a href={entry.data.source} rel="noopener">{entry.data.title}</a>
              <p class="meta">{entry.data.takeaway}</p>
            </li>
          ))}
        </ul>
      )}
      <p class="more"><a href="/reading/">Reading log</a></p>
    </div>
  </section>

  <section class="band band-raised">
    <div class="wrap">
      <p class="kicker">Where this comes from</p>
      <p class="origin">
        I work in security incident response by day: reading systems under stress,
        tracing how things break. The essays here come out of the same habit turned
        inward, on work, sincerity, and what the tradition has to say about both.
      </p>
      <p><a href="/about/">More about me</a></p>
    </div>
  </section>

  <section class="band closing-band">
    <div class="wrap">
      <h2 class="closing"><span class="orn" aria-hidden="true">&#1758;</span> May it be of benefit.</h2>
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    min-height: clamp(560px, 86vh, 760px);
    padding-block: clamp(3rem, 9vw, 6.5rem) 2rem;
    overflow: hidden;
    color: #efe8da;
    background:
      radial-gradient(46% 16% at 63% 53%, rgba(223, 167, 95, 0.16), transparent 70%),
      linear-gradient(180deg, #080c19 0%, #0b1020 30%, #101426 46%, #261c12 52.5%, #0b1322 56%, #060a12 100%);
  }
  .hero h1 { color: #f4eddd; }
  .hero .eyebrow { color: #93a7bd; }
  .hero .lede { color: rgba(239, 232, 218, 0.75); }
  .hero::after {
    content: '';
    position: absolute;
    left: 0; right: 0; bottom: 0;
    height: 30%;
    background: linear-gradient(to top, rgba(4, 7, 12, 0.5), transparent);
    pointer-events: none;
    z-index: 2;
  }
  .hero-inner { position: relative; z-index: 3; }
  .hero h1 {
    font-family: var(--font-display);
    font-size: clamp(3.4rem, 11vw, 7.5rem);
    line-height: 0.9;
    letter-spacing: -0.05em;
    margin: 0.6rem 0 1.6rem;
    max-width: 8ch;
  }
  .band-paper, .band-ground, .band-raised { padding-block: clamp(3rem, 7vw, 5rem); }
  :global(.band-paper) .bucket-label { color: rgba(32, 26, 18, 0.55); }
  :global(.band-paper) .bucket-desc { color: rgba(32, 26, 18, 0.74); }
  :global(.band-paper) .pending { color: rgba(32, 26, 18, 0.45); }
  :global(.band-paper) .item-title { color: #201a12; }
  .buckets {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 2.5rem 2rem;
  }
  .bucket-label {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 0.6rem;
  }
  .bucket .item-title { display: block; }
  .pending { color: var(--text-muted); }
  .bucket-desc { color: var(--text-secondary); font-size: 0.95rem; margin: 0.5rem 0 0; }

  .topics {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1.1rem 2.5rem;
  }
  .topics li {
    font-family: var(--font-display);
    font-size: 1.35rem;
    line-height: 1.2;
    color: var(--text);
  }
  .topic-num {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--machine);
    margin-right: 0.6rem;
    vertical-align: 0.15em;
  }
  .empty { color: var(--text-muted); max-width: 34rem; }
  .rows { list-style: none; margin: 0; padding: 0; }
  .rows li + li { margin-top: 1.8rem; }
  .note-body { color: var(--text-secondary); max-width: 40rem; }
  .note-body p { margin: 0.4rem 0 0; }
  .more { margin: 2rem 0 0; font-size: 0.92rem; }
  .origin { color: var(--text-secondary); max-width: 36rem; }
  .closing-band { text-align: center; }
  .closing {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 4.5vw, 3rem);
    letter-spacing: -0.03em;
    margin: 0;
    color: var(--text);
  }
  .orn { color: var(--accent); margin-right: 0.4rem; }
</style>
