---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

const notes = (await getCollection('notes')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const rendered = await Promise.all(
  notes.map(async (note) => ({ note, Content: (await render(note)).Content }))
);
---

<Base title="Notes · Ahmad Abdillah">
  <h1>Notes</h1>
  <p class="hint">Short captures. Most never become essays, and that is the point.</p>
  {rendered.length === 0 && <p class="empty">Nothing here yet.</p>}
  {rendered.map(({ note, Content }) => (
    <article class="note">
      <time datetime={note.data.pubDate.toISOString()}>
        {note.data.pubDate.toLocaleDateString('en-SG', { year: 'numeric', month: 'short', day: 'numeric' })}
      </time>
      <Content />
    </article>
  ))}
</Base>

<style>
  h1 { font-size: 1.8rem; }
  .hint { color: var(--muted); font-style: italic; }
  .empty { color: var(--muted); }
  .note { margin-bottom: 2rem; }
  .note time { display: block; color: var(--muted); font-size: 0.85rem; margin-bottom: 0.25rem; }
</style>
